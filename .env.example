APP_DOMAIN=sistema.seudominio.com.br
APP_ENV=production
NUXT_ENABLE_MOCK_AUTH=false
ENABLE_TTS=false
NUXT_AUTH_COOKIE_SECURE=true
TZ=America/Sao_Paulo
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

MYSQL_DATABASE=sistema_clinico_mvp
MYSQL_USER=clinico
MYSQL_PASSWORD=troque_essa_senha
MYSQL_ROOT_PASSWORD=troque_essa_senha_root

SECRET_KEY=troque_essa_secret_key
JWT_SECRET_KEY=troque_essa_jwt_secret_key

JWT_ACCESS_TOKEN_EXPIRES_SECONDS=43200
NUXT_PUBLIC_AUTH_COOKIE_MAX_AGE_SECONDS=43200
CORS_ORIGINS=https://sistema.seudominio.com.br
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
TTS_RATE_LIMIT=30 per minute

FIREBIRD_HOST=ip_ou_host_do_firebird
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=/caminho/para/o/banco.fdb
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=senha_firebird
FIREBIRD_CHARSET=WIN1252

RATELIMIT_STORAGE_URI=redis://redis:6379/1
LOGIN_RATE_LIMIT_IP=10 per minute
LOGIN_RATE_LIMIT_EMAIL=5 per minute

# Backup criptografado (a chave privada age nunca deve ficar na VPS)
BACKUP_DIR=/var/backups/sistema-clinico-mvp/mysql
BACKUP_RETENTION_DAYS=30
BACKUP_AGE_RECIPIENT=age1SUBSTITUA_PELO_DESTINATARIO_PUBLICO

# Retencao e descarte LGPD (validar prazos antes de ativar em producao)
LGPD_RETENTION_LOGS_INTEGRACAO_DAYS=180
LGPD_RETENTION_FILA_SINCRONIZACAO_DAYS=90
LGPD_RETENTION_AUDITORIA_DAYS=1825
LGPD_RETENTION_SPDATA_ESPELHO_DAYS=730
LGPD_RETENTION_BATCH_SIZE=500

SQLSERVER_HOST=ip_ou_host_sqlserver
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=master
SQLSERVER_USER=usuario_sqlserver_leitura
SQLSERVER_PASSWORD=senha_sqlserver
SQLSERVER_DRIVER="ODBC Driver 18 for SQL Server"
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_CERTIFICATE=yes
SQLSERVER_TIMEOUT=10
