SECRET_KEY=troque_essa_secret_key
JWT_SECRET_KEY=troque_essa_jwt_secret_key
SQLALCHEMY_DATABASE_URI=mysql+pymysql://clinico:troque_essa_senha@127.0.0.1:3306/sistema_clinico_mvp

FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_COLOR=auto
LOG_REQUESTS=true
LOG_HEALTHCHECKS=false

FIREBIRD_HOST=ip_ou_host_do_firebird
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=/caminho/para/o/banco.fdb
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=senha_firebird
FIREBIRD_CHARSET=WIN1252

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Retencao e descarte LGPD para execucao local
LGPD_RETENTION_LOGS_INTEGRACAO_DAYS=180
LGPD_RETENTION_FILA_SINCRONIZACAO_DAYS=90
LGPD_RETENTION_AUDITORIA_DAYS=1825
LGPD_RETENTION_SPDATA_ESPELHO_DAYS=730
LGPD_RETENTION_BATCH_SIZE=500

SQLSERVER_HOST=ip_ou_host_sqlserver
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=master
SQLSERVER_USER=usuario_sqlserver_leitura
SQLSERVER_PASSWORD=senha_sqlserver
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_CERTIFICATE=yes
SQLSERVER_TIMEOUT=10
